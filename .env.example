# Copy to .env and fill in. Never commit .env.

# A long-lived access token with ads_read permission (System User token recommended).
META_ACCESS_TOKEN=

# Comma-separated ad account IDs (with or without the act_ prefix).
# Leave blank to auto-discover every ad account the token can see.
META_AD_ACCOUNT_IDS=

# Graph API version to call.
META_API_VERSION=v24.0
